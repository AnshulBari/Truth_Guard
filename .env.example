# TruthGuard configuration. Copy to .env for the backend.
# Frontend-specific variables belong in frontend/.env.local; see frontend/.env.example.

# --- Model provider (optional) ---------------------------------------------
# Leave LLM_API_KEY unset to run in deterministic demo mode. The UI and API
# clearly label that mode; no model output is simulated.
#
# Any OpenAI-compatible chat-completions endpoint works.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60

# --- Backend ----------------------------------------------------------------
# Defaults to backend/data/truthguard.db
# TRUTHGUARD_DB=backend/data/truthguard.db
TRUTHGUARD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUTHGUARD_MAX_UPLOAD_MB=20

# --- Frontend ---------------------------------------------------------------
# Next.js loads its own env files. If the API is not on 127.0.0.1:8000, put
# BACKEND_URL in frontend/.env.local (see frontend/.env.example).
# BACKEND_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000/api
